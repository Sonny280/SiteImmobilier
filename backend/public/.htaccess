Options -MultiViews
RewriteEngine On

# Types MIME corrects pour les modules ES (fichiers .js)
AddType application/javascript .js .mjs
AddType text/css .css
AddType image/svg+xml .svg
AddType application/json .json
AddType image/webp .webp
AddType font/woff2 .woff2

# Headers pour les modules ES — nécessaire sur certains serveurs cPanel
<FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript"
</FilesMatch>
<FilesMatch "\.css$">
    Header set Content-Type "text/css"
</FilesMatch>

# Cache navigateur pour les assets avec hash (immutables)
<FilesMatch "\.(js|css|woff2|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Pas de cache sur index.html (doit toujours être la version actuelle)
<FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# ── ROUTAGE SPA ──────────────────────────────────────────────────
# Toutes les routes inconnues (pas un fichier physique, pas un dossier) →
# renvoyer index.html pour que React gère la navigation côté client.
# C'est ce qui fait fonctionner /bien/123, /services, /contact etc.
# après un rechargement de page ou un partage de lien direct.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
