# ── Variables d'environnement ImmobilierCI ──────────────────────
# Copiez ce fichier en .env et remplissez les valeurs réelles
# NE JAMAIS committer .env dans Git

NODE_ENV=production

# Secret JWT — générez une valeur aléatoire longue et unique
# Exemple : openssl rand -hex 32
JWT_SECRET=changez-cette-valeur-par-une-chaine-aleatoire-longue-et-unique

# URL du frontend (pour CORS) — remplacez par votre vraie URL Railway/Netlify
FRONTEND_URL=https://votre-frontend.railway.app,https://votre-frontend.netlify.app

# URL publique du backend (pour sitemap et emails)
SITE_URL=https://votre-backend.railway.app

# Port (Railway le définit automatiquement, ne pas changer)
PORT=3001

# ── Email SMTP (Gmail) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@immobilierci.ci
SMTP_PASS=votre_mot_de_passe_application_gmail

# ── Informations agence ─────────────────────────────────────────
AGENCY_NAME=ImmobilierCI
AGENCY_EMAIL=contact@immobilierci.ci
AGENCY_WHATSAPP=+2250757864836
AGENCY_TEL=+2250757864836
